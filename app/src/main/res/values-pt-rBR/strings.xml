    <string name="reliability_title">Lembretes confiáveis</string>
    <string name="reliability_intro">O Android e alguns fabricantes pausam apps em segundo plano para economizar bateria. Corrija os itens abaixo para que os lembretes toquem sempre, mesmo com a tela desligada.</string>
    <string name="reliability_all_ok">Tudo certo: o Medwi consegue lembrar você mesmo com a tela desligada e a economia de bateria ativa.</string>
    <string name="reliability_ok">OK</string>
    <string name="reliability_needs_fix">Corrigir</string>
    <string name="reliability_check_manually">Verificar</string>
    <string name="reliability_fix">Corrigir</string>
    <string name="reliability_open">Abrir</string>
    <string name="reliability_mark_done">Já fiz</string>
    <string name="reliability_undo_done">Ainda não</string>
    <string name="reliability_test">Enviar notificação de teste</string>
    <string name="reliability_test_hint">Confira se ela toca som e aparece por cima da tela e na tela de bloqueio.</string>
    <string name="rel_notifications_title">Notificações</string>
    <string name="rel_notifications_body">Permita as notificações e mantenha a categoria “Lembretes de medicação” com som e pop-up.</string>
    <string name="rel_exact_title">Alarmes e lembretes</string>
    <string name="rel_exact_body">Permite que o lembrete toque no minuto exato, sem atrasos do sistema.</string>
    <string name="rel_battery_title">Otimização de bateria</string>
    <string name="rel_battery_body">Na lista, mostre todos os apps, encontre o Medwi e deixe como “Sem restrições” / “Não otimizar” para o sistema não segurar os lembretes em repouso.</string>
    <string name="rel_background_title">Atividade em segundo plano</string>
    <string name="rel_background_body">O uso em segundo plano está restrito para o Medwi. Libere nas configurações de bateria do app.</string>
    <string name="rel_autostart_title">Início automático (fabricante)</string>
    <string name="rel_autostart_body">Seu celular tem um gerenciador próprio que pode fechar o Medwi. Permita o início automático / execução em segundo plano e toque em “Já fiz”.</string>
    <string name="rel_tip_xiaomi">Xiaomi/Redmi/POCO: ative “Início automático” para o Medwi. Em Info do app › Economia de bateria, escolha “Sem restrições”.</string>
    <string name="rel_tip_huawei">Huawei/Honor: em Inicialização de apps, desative “Gerenciar automaticamente” do Medwi e ative as três opções.</string>
    <string name="rel_tip_oppo">Oppo/Realme/OnePlus: permita “Início automático” e, em Uso da bateria, permita atividade em segundo plano.</string>
    <string name="rel_tip_vivo">Vivo/iQOO: permita a inicialização em segundo plano e deixe o consumo de bateria em “Alto consumo em segundo plano”.</string>
    <string name="rel_tip_samsung">Samsung: em Bateria › Limites de uso em segundo plano, adicione o Medwi a “Apps nunca suspensos”.</string>
    <string name="rel_tip_generic">Procure por “Início automático”, “Execução em segundo plano” ou “Apps protegidos” e libere o Medwi.</string>
    <string name="test_notif_title">Teste do Medwi</string>
    <string name="test_notif_body">Se você está vendo e ouvindo isto, seus lembretes de dose vão funcionar.</string>


