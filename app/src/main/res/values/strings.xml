    <string name="reliability_review">Review</string>
    <string name="reliability_title">Reliable reminders</string>
    <string name="reliability_intro">Android and some phone brands pause apps in the background to save battery. Fix the items below so dose reminders always go off, even with the screen off.</string>
    <string name="reliability_all_ok">All set: Medwi can remind you even with the screen off and battery saver on.</string>
    <string name="reliability_ok">OK</string>
    <string name="reliability_needs_fix">Needs fixing</string>
    <string name="reliability_check_manually">Check</string>
    <string name="reliability_fix">Fix</string>
    <string name="reliability_open">Open</string>
    <string name="reliability_mark_done">Done</string>
    <string name="reliability_undo_done">Not done</string>
    <string name="reliability_test">Send a test notification</string>
    <string name="reliability_test_hint">Check that it makes sound and shows up on top of the screen and on the lock screen.</string>
    <string name="rel_notifications_title">Notifications</string>
    <string name="rel_notifications_body">Allow notifications and keep the “Medication reminders” category with sound and pop-up.</string>
    <string name="rel_exact_title">Alarms &amp; reminders</string>
    <string name="rel_exact_body">Lets the reminder go off at the exact minute instead of being delayed by the system.</string>
    <string name="rel_battery_title">Battery optimization</string>
    <string name="rel_battery_body">In the list, show all apps, find Medwi and set it to “Unrestricted” / “Don’t optimize” so the system doesn’t hold back reminders in standby.</string>
    <string name="rel_background_title">Background activity</string>
    <string name="rel_background_body">Background use is restricted for Medwi. Allow it in the app’s battery settings.</string>
    <string name="rel_autostart_title">Auto-start (phone brand)</string>
    <string name="rel_autostart_body">Your phone has its own app manager that can close Medwi. Allow auto-start / background launch for Medwi, then tap “Done”.</string>
    <string name="rel_tip_xiaomi">Xiaomi/Redmi/POCO: turn on Autostart for Medwi. In App info › Battery saver, choose “No restrictions”.</string>
    <string name="rel_tip_huawei">Huawei/Honor: in App launch, turn off “Manage automatically” for Medwi and enable all three options.</string>
    <string name="rel_tip_oppo">Oppo/Realme/OnePlus: allow Auto launch, and in Battery usage allow background activity.</string>
    <string name="rel_tip_vivo">Vivo/iQOO: allow background startup and set battery usage to “High background power consumption”.</string>
    <string name="rel_tip_samsung">Samsung: in Battery › Background usage limits, add Medwi to “Never sleeping apps”.</string>
    <string name="rel_tip_generic">Look for “Auto-start”, “Background launch” or “Protected apps” and allow Medwi.</string>
    <string name="test_notif_title">Medwi test</string>
    <string name="test_notif_body">If you can see and hear this, your dose reminders will work.</string>


